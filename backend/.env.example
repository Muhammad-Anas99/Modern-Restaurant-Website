# Server
PORT=5000
NODE_ENV=development

# MongoDB (use MongoDB Atlas connection string in production)
MONGO_URI=mongodb://127.0.0.1:27017/foundry-flame

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated origins allowed to call this API.
# Leave this BLANK for local development — an empty value allows all origins,
# so you won't fight CORS while testing with `npx serve frontend`, Live Server, etc.
# In production, set it to your exact deployed frontend URL(s), comma-separated,
# no trailing slash — e.g.:
#   CORS_ORIGIN=https://your-frontend-project.vercel.app
CORS_ORIGIN=

# First-run admin account (used only by seed.js)
SEED_ADMIN_EMAIL=owner@yourrestaurant.com
SEED_ADMIN_PASSWORD=change_this_password

# Image uploads (Menu/Offer image upload from the admin panel)
# Create a Blob store: Vercel dashboard -> your backend project -> Storage -> Create Database -> Blob.
# Vercel adds this token automatically once the store is connected to the project.
# For local development, copy the same token from Vercel dashboard -> Storage -> your Blob store -> .env.local tab.
BLOB_READ_WRITE_TOKEN=
